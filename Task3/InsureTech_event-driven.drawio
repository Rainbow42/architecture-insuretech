        <mxCell id="settlement" value="ins-comp-settlement&#xa;[Container]&#xa;product + policy projections, monthly registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="180" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="settlementdb" value="settlement PostgreSQL&#xa;idempotency + read models" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1260" y="360" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="registry" value="Schema Registry&#xa;backward compatibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1230" y="540" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="dlq" value="DLQ + retry topics&#xa;alert on consumer lag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1230" y="660" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="note" value="Transactional Outbox применяется в core-app: policy и outbox фиксируются одной транзакцией. Потребители идемпотентны по event_id. Декомпозиция функций сервисов не меняется; исключены REST-опросы core-app → aggregator и settlement → core-app." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="780" width="500" height="120" as="geometry"/></mxCell>

        <mxCell id="e1" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="web" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
