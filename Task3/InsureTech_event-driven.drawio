        <mxCell id="kafka" value="Kafka cluster (3 AZ)&#xa;[Event Streaming Platform]&#xa;RF=3, min ISR=2, TLS + ACL" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="topicProducts" value="topic: product.updated&#xa;key=product_id&#xa;schema versioned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="785" y="500" width="250" height="80" as="geometry"/></mxCell>
