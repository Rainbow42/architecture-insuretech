        <mxCell id="e4" value="publish policy.issued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="relay" target="topicPolicies"><mxGeometry relative="1" as="geometry"/></mxCell>
