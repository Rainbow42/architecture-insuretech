        <mxCell id="e7" value="consume (core-products group)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="topicProducts" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
