        <mxCell id="pattern-breaker" value="Circuit Breaker" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;aspect=fixed;sketch=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;spacing=1;fillColor=#2875E2;strokeColor=#ffffff;shape=mxgraph.kubernetes.icon2;prIcon=c_role;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];" vertex="1" parent="1"><mxGeometry x="1913" y="1050" width="50" height="48" as="geometry"/></mxCell>
        <mxCell id="sse-note" value="SSE из любого pod: журнал предложений в общей core DB, id = seq заявки, Last-Event-ID.&#xa;LISTEN/NOTIFY — только сигнал перечитать БД; после reconnect и по таймеру выполняется replay. Sticky sessions не нужны. Retention журнала — 24 ч, не 60 с." style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="1600" width="590" height="125" as="geometry"/></mxCell>
        <mxCell id="deadline-note" value="2500 заявок × 10 компаний = до 25 000 задач.&#xa;Один deadline = accepted_at + 60 с, включая очередь и повторы. Полученные ответы выдаются сразу, остальные завершаются timeout.&#xa;Расчёт лимитов и API: README.md." style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1460" y="1600" width="510" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
