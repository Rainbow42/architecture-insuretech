<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="Codex" version="24.7.17" compressed="false">
  <diagram id="osago" name="OSAGO C4 containers">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="InsureTech — продажа ОСАГО онлайн (C4, Container)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="user" value="Клиент&#xa;[Person]" style="shape=mxgraph.aws4.user;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="web" value="Web application&#xa;[Container]&#xa;форма заявки, поток предложений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="core" value="core-app (несколько pod)&#xa;[Container]&#xa;заявка ОСАГО, авторизация, SSE endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="coredb" value="core PostgreSQL&#xa;application + outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="685" y="320" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="sse" value="Redis Pub/Sub&#xa;SSE fan-out между pod&#xa;TTL 60 сек." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="270" height="90" as="geometry"/></mxCell>

        <mxCell id="kafka" value="Kafka (3 AZ)&#xa;[Event Streaming]&#xa;partition key = application_id" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030" y="300" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="commands" value="osago.application.created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1055" y="500" width="220" height="55" as="geometry"/></mxCell>
        <mxCell id="offers" value="osago.offer.received" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1055" y="590" width="220" height="55" as="geometry"/></mxCell>

        <mxCell id="aggregator" value="osago-aggregator (несколько pod)&#xa;[Container]&#xa;async workers, poll scheduler, deadline 60 сек.&#xa;идемпотентность по application_id + insurer_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="140" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="aggdb" value="osago PostgreSQL&#xa;application correlation, insurer request IDs,&#xa;offers, status, deadline, processed event IDs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1435" y="350" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="queue" value="Очередь/пул на страховую&#xa;bulkhead, backpressure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1420" y="535" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="insurers" value="10 страховых компаний&#xa;[External systems]&#xa;POST application / GET offer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1420" y="700" width="260" height="100" as="geometry"/></mxCell>

        <mxCell id="apiNote" value="API для Web → core-app&#xa;POST /api/v1/osago/applications (REST)&#xa;GET /api/v1/osago/applications/{id}/offers (SSE)&#xa;Предложения отправляются сразу после события; соединение живёт ≤60 сек." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="370" width="500" height="150" as="geometry"/></mxCell>
        <mxCell id="internalNote" value="API osago-aggregator для core-app&#xa;AsyncAPI: consume osago.application.created; publish osago.offer.received.&#xa;REST GET /internal/v1/applications/{id} — только сверка/восстановление.&#xa;Команды и результаты не зависят от конкретного pod." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="590" width="600" height="150" as="geometry"/></mxCell>
        <mxCell id="patterns" value="Паттерны на внешнем вызове&#xa;Rate Limiter — отдельный лимит каждой страховой&#xa;Circuit Breaker — изоляция недоступного API&#xa;Retry — exponential backoff + jitter только для безопасных/idempotent вызовов&#xa;Timeout — каждый вызов 3 сек., общий deadline 60 сек.&#xa;Bulkhead — отдельный worker pool на партнёра" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="745" width="570" height="190" as="geometry"/></mxCell>
        <mxCell id="existing" value="Сохранённый Event-Driven-контур из Task3&#xa;client-info + PostgreSQL ↔ core-app (синхронный API)&#xa;ins-product-aggregator → Kafka product.updated → core-app и ins-comp-settlement&#xa;core-app Outbox Relay → Kafka policy.issued → ins-comp-settlement&#xa;Schema Registry, DLQ, идемпотентные потребители" style="swimlane;html=1;rounded=1;startSize=30;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="790" width="650" height="150" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="user" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="REST: создать заявку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="web" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="SSE: каждое предложение сразу" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="core" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="transaction: application + outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="core" target="coredb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="publish command (outbox relay)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="coredb" target="commands"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="consume command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="commands" target="aggregator"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="persist state / lease work" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="aggregator" target="aggdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="dispatch per insurer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="aggregator" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="[RL] [CB] [Retry] [Timeout] [Bulkhead]&#xa;REST POST + polling GET" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="queue" target="insurers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="publish each offer immediately" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="aggregator" target="offers"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="consume offer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="offers" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="publish for all core pods" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="core" target="sse"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
