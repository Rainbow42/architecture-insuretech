        <mxCell id="dbAsync" value="Zone C&#xa;асинхронная replica&#xa;read-only / DR" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="dbgroup"><mxGeometry x="730" y="65" width="190" height="95" as="geometry"/></mxCell>

        <mxCell id="storage" value="Object Storage&#xa;pgBackRest: base backup ежедневно&#xa;WAL непрерывно, PITR; retention 30 дней&#xa;cross-zone, restore drill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="790" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="monitoring" value="Monitoring + Logging + Alerting&#xa;SLO 99,9%, latency, 5xx, saturation;&#xa;synthetic checks из регионов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="740" y="790" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="decision" value="Решение: горизонтальное масштабирование stateless-сервисов. Три независимых кластера изолируют отказ площадки и blast radius; единый растянутый кластер не выбран из-за зависимости control plane и межзонной сети. Active-active на уровне приложения, автоматический DNS failover. Шардирование БД не требуется: объём 50 GB; сложность и риск распределённых транзакций выше пользы. Вертикальный запас + read replicas." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="610" height="220" as="geometry"/></mxCell>
        <mxCell id="rto" value="RTO ≤45 мин: автоматический DB failover и DNS health checks — минуты.&#xa;RPO ≤15 мин: sync replica RPO≈0; WAL archive/PITR — до 15 мин при полном отказе кластера." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="610" height="125" as="geometry"/></mxCell>

