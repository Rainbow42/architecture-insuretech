        <mxCell id="entry" value="api.insuretech: HTTPS → ALB A/B/C&#xa;WAF, TLS, auth, лимит на клиента&#xa;блок обозначает три входа, не один сервер" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="230" width="1290" height="90" as="geometry"/></mxCell>
