        <mxCell id="dns" value="GeoDNS&#xa;DNS-ответ с адресом&#xa;доступного ALB; TTL 30 с" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="cdn" value="CDN: точки присутствия в РФ&#xa;статика и публичные страницы&#xa;персональные ответы не кэшируются" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="370" height="100" as="geometry"/></mxCell>
