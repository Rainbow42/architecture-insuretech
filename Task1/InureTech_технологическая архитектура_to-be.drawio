        <mxCell id="appsC" value="Web, core-app, client-info,&#xa;ins-product-aggregator, ins-comp-settlement&#xa;≥2 pod / сервис; ≥2 worker-узла&#xa;HPA, PDB, anti-affinity" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1275" y="560" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="ingC" value="HTTPS" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="albC"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1445" y="355"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="lbC" value="readiness /readyz" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="albC" target="appsC"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="writer" value="pg-writer: локальный Service + 2 HAProxy в каждом Kubernetes&#xa;Единый адрес записи для приложения; backend только с HTTP 200 на Patroni /primary:8008" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="750" width="1290" height="90" as="geometry"/></mxCell>
        <mxCell id="writeA" value="SQL: запись и согласованное чтение" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="appsA" target="writer"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="writeB" value="SQL: запись и согласованное чтение" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="appsB" target="writer"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="writeC" value="SQL: запись и согласованное чтение" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="appsC" target="writer"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="primary" value="Зона A: PostgreSQL + Patroni&#xa;текущий primary; 50 GB" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;shape=cylinder3;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="350" y="960" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="sync" value="Зона B: PostgreSQL + Patroni&#xa;текущая sync-реплика; read-only" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;shape=cylinder3;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="820" y="960" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="candidate" value="Зона C: PostgreSQL + Patroni&#xa;резервный кандидат sync; read-only" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;shape=cylinder3;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1290" y="960" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="dbwrite" value="SQL → текущий primary" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.14;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="writer" target="primary"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="dbfailB" value="SQL только после promotion" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="writer" target="sync"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="dbfailC" value="SQL только после promotion" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.86;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="writer" target="candidate"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="replB" value="streaming, sync" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.45;entryX=0;entryY=0.45;" edge="1" parent="1" source="primary" target="sync"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="replC" value="streaming; Patroni выбирает sync-кандидата" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="primary" target="candidate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="1100"/><mxPoint x="1470" y="1100"/></Array><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="dcs" value="etcd: по одному участнику в A / B / C, кворум 2 из 3&#xa;Patroni: leader lease, fencing старого primary; без кворума запись запрещена&#xa;synchronous_mode=on, synchronous_mode_strict=true, synchronous_node_count=1" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="350" y="1150" width="810" height="110" as="geometry"/></mxCell>
        <mxCell id="backup" value="Object Storage: отдельный регион, отдельные права&#xa;pgBackRest: full ежедневно, diff ежечасно; WAL&#xa;archive_timeout=60 с; хранение 30 дней&#xa;проверка WAL lag, резервной копии и восстановления" style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1240" y="1150" width="530" height="110" as="geometry"/></mxCell>
        <mxCell id="lease" value="DCS lease" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.35;exitY=1;entryX=0.1;entryY=0;dashed=1;" edge="1" parent="1" source="primary" target="dcs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="476" y="1120"/><mxPoint x="431" y="1120"/></Array></mxGeometry></mxCell>
        <mxCell id="archive" value="base backup + WAL от текущего primary" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.97;exitY=1;entryX=1;entryY=0.3;dashed=1;" edge="1" parent="1" source="primary" target="backup"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1125"/><mxPoint x="1810" y="1125"/><mxPoint x="1810" y="1183"/></Array><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="strategy" value="Выбрала горизонтальное масштабирование сервисов и три независимых кластера: отказ control plane одной зоны не останавливает другие. Вертикально увеличивается БД. Шардирование для 50 GB не требуется.&#xa;При сбое ALB GeoDNS исключает адрес; клиент повторно разрешает DNS и переподключается. Повтор POST — только с ключом идемпотентности." style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="1320" width="570" height="175" as="geometry"/></mxCell>
        <mxCell id="slo" value="Цели: доступность 99,9%; RTO ≤45 мин; RPO ≤15 мин.&#xa;Отказ одной зоны: Patroni продвигает подтверждённую sync-реплику, HAProxy меняет backend. Подтверждённые записи сохраняются.&#xa;Полное восстановление: 5 мин обнаружение + 30 восстановление + 5 переключение + 5 проверка. Это бюджет, его проверяют restore drill." style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640" y="1320" width="570" height="175" as="geometry"/></mxCell>
        <mxCell id="checks" value="Health checks: GeoDNS → каждый ALB /readyz (5 с × 3); ALB → readiness pod; kubelet → startup/readiness/liveness; HAProxy → Patroni /primary (2 с × 3); Patroni → PostgreSQL и etcd.&#xa;Алерты во всех зонах: 5xx, p95, репликация, WAL archive lag &gt;5 мин. CDN снижает разницу загрузки страниц; p95 измеряется из регионов." style="whiteSpace=wrap;html=1;fontSize=16;spacing=8;rounded=0;fillColor=#f5f5f5;strokeColor=#cccccc;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1250" y="1320" width="570" height="175" as="geometry"/></mxCell>
        <mxCell id="resolve" value="DNS-запрос" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="users" target="dns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="html" value="HTTPS: страницы" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="cdn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="160"/><mxPoint x="320" y="120"/></Array></mxGeometry></mxCell>
        <mxCell id="api" value="HTTPS: API" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="entry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="220"/><mxPoint x="315" y="275"/></Array></mxGeometry></mxCell>
        <mxCell id="originReq" value="HTTPS: cache miss" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cdn" target="origin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dnshealth" value="GET /readyz каждого ALB" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.8;dashed=1;" edge="1" parent="1" source="dns" target="entry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="380"/><mxPoint x="315" y="302"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
